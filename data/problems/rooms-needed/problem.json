      }
    ],
    "common_mistakes": [
      {
        "id": "m1",
        "description": "uses < instead of <= when checking whether a room has freed up",
        "symptom": "needs 2 rooms for [[1, 2], [2, 3]] instead of 1"
      },
      {
        "id": "m2",
        "description": "merges overlapping meetings and counts the blocks",
        "symptom": "answers a different question; gives 1 for [[1, 5], [2, 6], [3, 7]]"
      },
      {
        "id": "m3",
        "description": "only compares each meeting with the one before it",
        "symptom": "misses three-way overlaps"
      }
    ],
    "wrap_up_questions": [
