  "rubric": {
    "approaches": [
      {
        "name": "sort by start, min-heap of end times",
        "time": "O(n log n)",
        "space": "O(n)",
        "acceptable": true
      },
      {
        "name": "sort starts and ends separately and sweep",
        "time": "O(n log n)",
        "space": "O(n)",
        "acceptable": true
      },
      {
        "name": "count overlaps at every start",
        "time": "O(n^2)",
        "space": "O(1)",
        "acceptable": false
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Asks whether a meeting ending at the same time another starts can share the room, and whether input is sorted.",
        "look_for": [
          "asks about back-to-back meetings",
          "asks whether meetings are sorted",
          "mentions no meetings"
        ],
        "hints": [
          "Before you start, is there anything about how meetings meet that you'd want to confirm?",
          "If one meeting ends at 2 and another starts at 2, do they need different rooms?",
          "Confirm that back-to-back meetings can share a room and the input may be unsorted."
        ]
      },
      {
        "id": "s2",
        "title": "Process meetings by start time",
        "required": true,
        "order": 2,
        "description": "Sorts the meetings by start so rooms are assigned in time order.",
        "look_for": [
          "sorts by start"
        ],
        "hints": [
          "Look at the order you assign rooms in.",
          "Does it matter whether you place a 9 o'clock meeting before an 11 o'clock one?",
          "Sort by start time so you always assign the next meeting to start."
        ]
      },
      {
        "id": "s3",
        "title": "Reuse the room that frees up first",
        "required": true,
        "order": 3,
        "description": "Keeps the end times of rooms in use in a min-heap and reuses the earliest one if it has ended.",
        "look_for": [
          "uses heapq for end times",
          "compares the earliest end with the new start"
        ],
        "hints": [
          "Look at how you decide whether a room is free.",
          "Among the rooms in use, which one is worth checking first?",
          "Keep a min-heap of end times; if the earliest end is at or before the new start, reuse that room."
        ]
      },
      {
        "id": "s4",
        "title": "Report the peak",
        "required": true,
        "order": 4,
        "description": "The number of rooms in the heap at the end, or the maximum during the sweep, is the answer.",
        "look_for": [
          "returns the heap size",
          "or tracks the maximum count"
        ],
        "hints": [
          "Check what number your code reports at the end.",
          "Does the heap ever shrink in your approach, and does that matter?",
          "With replace-on-reuse, the heap's final size is the number of rooms ever needed."
        ]
      }
    ],
    "edge_cases": [
