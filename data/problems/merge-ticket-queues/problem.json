    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Confirms both lists are sorted, that repeated numbers are kept, and that either list may be empty.",
        "look_for": [
          "asks whether the queues are sorted",
          "asks whether duplicates are kept",
          "mentions an empty queue"
        ],
        "hints": [
          "Before you start, is there anything about the two queues you'd want to confirm?",
          "Are the queues already in order, and should repeated numbers appear twice in the result?",
          "Confirm both inputs are sorted, duplicates stay, and either can be empty."
        ]
      },
      {
        "id": "s2",
        "title": "Walk both queues with two pointers",
        "required": true,
        "order": 2,
        "description": "Compares the front of each queue and takes the smaller one, advancing that pointer.",
        "look_for": [
          "keeps an index into each list",
          "compares the two current values"
        ],
        "hints": [
          "Look at how you decide which number goes next.",
          "Since both queues are sorted, where must the next smallest number be?",
          "Keep one pointer per queue and always take the smaller of the two fronts."
        ]
      },
      {
        "id": "s3",
        "title": "Append what's left over",
        "required": true,
        "order": 3,
        "description": "Adds the remaining numbers of whichever queue isn't finished when the other runs out.",
        "look_for": [
          "extends with the rest of a after the loop",
          "extends with the rest of b"
        ],
        "hints": [
          "Try your code with one queue much longer than the other.",
          "When one queue runs out, what happens to the numbers still waiting in the other?",
          "After the loop, add the leftover part of both queues; at most one is non-empty."
        ]
      },
      {
        "id": "s4",
        "title": "Keep every ticket",
        "required": false,
        "order": 4,
        "description": "Doesn't drop repeated numbers, for example by using a set.",
        "look_for": [
          "avoids converting to a set",
          "tests repeated numbers"
        ],
        "hints": [
          "Check what happens when the same number is in both queues.",
          "Does your result have exactly as many numbers as the two queues combined?",
          "The result should hold exactly as many numbers as both queues together; keep duplicates."
        ]
      }
    ],
    "edge_cases": [
      {
