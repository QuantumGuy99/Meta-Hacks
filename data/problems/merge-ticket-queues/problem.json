    "common_mistakes": [
      {
        "id": "m1",
        "description": "forgets the leftover numbers after the loop",
        "symptom": "fails when one queue is empty or ends early, like [3, 6] and []"
      },
      {
        "id": "m2",
        "description": "merges through a set",
        "symptom": "drops repeated numbers like [1, 1] and [1]"
      },
      {
        "id": "m3",
        "description": "pops from the front of a list",
        "symptom": "correct but O(n^2) on long queues"
      }
