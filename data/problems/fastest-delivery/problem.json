  "rubric": {
    "approaches": [
      {
        "name": "Dijkstra's algorithm with a min-heap",
        "time": "O((V + E) log V)",
        "space": "O(V + E)",
        "acceptable": true
      },
      {
        "name": "Bellman-Ford",
        "time": "O(V * E)",
        "space": "O(V)",
        "acceptable": false
      },
      {
        "name": "breadth-first search by number of roads",
        "time": "O(V + E)",
        "space": "O(V)",
        "acceptable": false
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Confirms roads are one-way, asks about unreachable stops, parallel roads and zero-minute roads.",
        "look_for": [
          "asks whether roads are one-way",
          "asks what to return if stop n - 1 is unreachable",
          "asks about 0-minute or duplicate roads"
        ],
        "hints": [
          "Before you start, is there anything about the roads you'd want to confirm?",
          "Can you drive a road in both directions, and what if the last stop can't be reached?",
          "Settle one-way roads, unreachable stops and duplicate or zero-minute roads first."
        ]
      },
      {
        "id": "s2",
        "title": "Build an adjacency list",
        "required": true,
        "order": 2,
        "description": "Turns the road list into, for each stop, the roads leaving it.",
        "look_for": [
          "builds a list or dict of outgoing roads",
          "only adds the from \u2192 to direction"
        ],
        "hints": [
          "Look at how you find the roads leaving a stop.",
          "Would scanning every road each time be fast enough?",
          "Group the roads by their starting stop in an adjacency list."
        ]
      },
      {
        "id": "s3",
        "title": "Always expand the fastest-known stop",
        "required": true,
        "order": 3,
        "description": "Uses a priority queue keyed by travel time so each stop is settled at its fastest time.",
        "look_for": [
          "uses heapq",
          "explains why fewest roads isn't fastest"
        ],
        "hints": [
          "Look at the order in which your search visits stops.",
          "Is the route with the fewest roads always the fastest one?",
          "Use Dijkstra's algorithm: a min-heap of times and stops, always expanding the smallest time."
        ]
      },
      {
        "id": "s4",
        "title": "Skip outdated heap entries",
        "required": true,
        "order": 4,
        "description": "Ignores a popped entry when a faster time for that stop was already found.",
        "look_for": [
          "compares the popped time with the best time",
          "continues past stale entries"
        ],
        "hints": [
          "Check what happens when the same stop is pushed twice with different times.",
          "When you pop a stop with a slower time than you already know, should you expand it?",
          "If the popped time is worse than the stored best, skip it."
        ]
      },
      {
        "id": "s5",
        "title": "Handle unreachable and trivial cases",
        "required": true,
        "order": 5,
        "description": "Returns -1 when stop n - 1 is never reached and 0 when n is 1.",
        "look_for": [
          "returns -1 after the heap empties",
          "tests n = 1"
        ],
        "hints": [
          "Try your code where the last stop has no roads into it.",
          "What does your function give back if the heap empties first, or if there's only one stop?",
          "Return -1 if the last stop is never reached; with one stop the answer is 0."
        ]
      }
    ],
    "edge_cases": [
      {
        "id": "e1",
        "description": "a single stop"
      },
      {
        "id": "e2",
        "description": "no roads"
      },
      {
        "id": "e3",
        "description": "roads that only point the wrong way"
      },
      {
        "id": "e4",
        "description": "zero-minute roads"
      },
      {
        "id": "e5",
        "description": "a cycle"
      },
      {
        "id": "e6",
        "description": "the fastest route uses more roads"
      }
    ],
    "common_mistakes": [
      {
        "id": "m1",
        "description": "uses breadth-first search by number of roads",
        "symptom": "returns 5 instead of 4 on the first example"
      },
      {
        "id": "m2",
        "description": "treats roads as two-way",
        "symptom": "finds routes that don't exist, failing when roads point the wrong way"
      },
      {
        "id": "m3",
        "description": "marks a stop finished when it's first pushed",
        "symptom": "can lock in a slower time before a faster route is found"
      }
    ],
    "wrap_up_questions": [
      "What are the time and space complexity?",
      "What breaks if some roads had negative minutes, and what would you use instead?"
    ]
  },
  "time_limit_min": 40,
  "illustration": null,
  "origin_note": "Original. Pattern: Dijkstra's algorithm with a min-heap."
