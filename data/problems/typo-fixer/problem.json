  "rubric": {
    "approaches": [
      {
        "name": "dynamic programming over prefixes",
        "time": "O(n * m)",
        "space": "O(min(n, m)) with two rows",
        "acceptable": true
      },
      {
        "name": "plain recursion over the three edits",
        "time": "exponential",
        "space": "O(n + m)",
        "acceptable": false
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Confirms which edits are allowed and that each costs 1, and asks about empty words.",
        "look_for": [
          "asks which edits are allowed",
          "asks whether a swap counts",
          "mentions empty strings"
        ],
        "hints": [
          "Before you start, is there anything about the allowed edits you'd want to confirm?",
          "Does swapping two neighboring letters count as one edit?",
          "Confirm only insert, delete and replace, each costing 1, and settle empty words."
        ]
      },
      {
        "id": "s2",
        "title": "Define the subproblem",
        "required": true,
        "order": 2,
        "description": "Defines the answer for the first i letters of one word and the first j of the other.",
        "look_for": [
          "defines a table over prefixes",
          "explains what one cell means"
        ],
        "hints": [
          "Think about smaller versions of the same question.",
          "If you knew the edits needed for shorter starting pieces of each word, could you build on that?",
          "Let a cell hold the edits needed to turn the first i letters of a into the first j letters of b."
        ]
      },
      {
        "id": "s3",
        "title": "Write the transition",
        "required": true,
        "order": 3,
        "description": "Uses the diagonal when letters match, otherwise 1 plus the best of insert, delete and replace.",
        "look_for": [
          "handles matching letters with no cost",
          "takes the minimum of three neighbors plus one"
        ],
        "hints": [
          "Look at what you do when the last letters match versus when they don't.",
          "If the last letters differ, which three smaller problems could you have come from?",
          "Match costs nothing; otherwise it's 1 plus the minimum of the insert, delete and replace cells."
        ]
      },
      {
        "id": "s4",
        "title": "Fill in the base cases",
        "required": true,
        "order": 4,
        "description": "Initializes the first row and column with the number of inserts or deletes against an empty word.",
        "look_for": [
          "first row is 0 to m",
          "first column is 0 to n"
        ],
        "hints": [
          "Check the values in the first row and column of your table.",
          "How many edits turn a word into an empty word?",
          "Turning i letters into nothing takes i deletions; nothing into j letters takes j inserts."
        ]
      },
      {
        "id": "s5",
        "title": "Keep memory small",
        "required": false,
        "order": 5,
        "description": "Notes that only the previous row is needed, so memory can be two rows instead of the full table.",
        "look_for": [
          "keeps only two rows",
          "or mentions the space optimization"
        ],
        "hints": [
          "Look at which cells each new cell depends on.",
          "Do you ever need rows older than the previous one?",
          "Keep just the previous and current rows."
        ]
      }
    ],
    "edge_cases": [
      {
        "id": "e1",
        "description": "both empty"
      },
      {
        "id": "e2",
        "description": "one word empty"
      },
      {
        "id": "e3",
        "description": "every letter different"
      },
      {
        "id": "e4",
        "description": "only deletions needed"
      },
      {
        "id": "e5",
        "description": "long words"
      }
    ],
    "common_mistakes": [
      {
        "id": "m1",
        "description": "uses plain recursion without memoization",
        "symptom": "correct but exponential, far too slow for 1,000-letter words"
      },
      {
        "id": "m2",
        "description": "forgets to initialize the first row and column",
        "symptom": "gets the empty-word cases wrong"
      },
      {
        "id": "m3",
        "description": "charges for a match",
        "symptom": "returns too many edits whenever letters line up"
      }
    ],
    "wrap_up_questions": [
      "What are the time and space complexity?",
      "How would you also return the actual list of edits?"
    ]
  },
