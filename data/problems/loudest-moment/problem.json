  "rubric": {
    "approaches": [
      {
        "name": "deque of indexes with decreasing readings",
        "time": "O(n)",
        "space": "O(k)",
        "acceptable": true
      },
      {
        "name": "heap with lazy removal",
        "time": "O(n log n)",
        "space": "O(n)",
        "acceptable": true
      },
      {
        "name": "max of every window",
        "time": "O(n * k)",
        "space": "O(1)",
        "acceptable": false
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Asks what to return when there are fewer readings than k, and confirms windows are consecutive readings.",
        "look_for": [
          "asks about fewer readings than k",
          "mentions k equal to 1"
        ],
        "hints": [
          "Before you start, is there anything about the windows you'd want to confirm?",
          "What should the answer be if there aren't enough readings for one full window?",
          "Settle the not-enough-readings case and confirm windows are consecutive."
        ]
      },
      {
        "id": "s2",
        "title": "Avoid rescanning each window",
        "required": true,
        "order": 2,
        "description": "Recognizes that taking the max of every window is O(n times k) and looks for a way to reuse work.",
        "look_for": [
          "says recomputing each window is too slow",
          "looks for a structure that keeps the max"
        ],
        "hints": [
          "Look at how much work your code does each time the window moves by one.",
          "When the window slides by one reading, how much really changes?",
          "Find a structure that keeps the current max available as readings enter and leave."
        ]
      },
      {
        "id": "s3",
        "title": "Keep a decreasing deque",
        "required": true,
        "order": 3,
        "description": "Keeps indexes in a deque whose readings decrease, dropping smaller readings from the back when a new one arrives.",
        "look_for": [
          "uses collections.deque",
          "pops smaller readings from the back"
        ],
        "hints": [
          "Check which readings could ever be the max of a future window.",
          "If a newer reading is at least as loud as an older one, can the older one ever be a peak again?",
          "Keep a deque of indexes with decreasing readings; drop any reading that a newer, louder one beats."
        ]
      },
      {
        "id": "s4",
        "title": "Drop readings that leave the window",
        "required": true,
        "order": 4,
        "description": "Removes the front index once it's outside the current window.",
        "look_for": [
          "checks the front index against i minus k",
          "stores indexes, not values"
        ],
        "hints": [
          "Look at what happens to a loud reading once the window moves past it.",
          "How do you know the front of the deque is still inside the window?",
          "Store indexes, and pop the front when it falls out of the window."
        ]
      },
      {
        "id": "s5",
        "title": "Record peaks once windows are full",
        "required": true,
        "order": 5,
        "description": "Starts recording the front reading only after the first k readings.",
        "look_for": [
          "records only when i is at least k minus 1"
        ],
        "hints": [
          "Count how many peaks your code produces.",
          "How many full windows are there in n readings?",
          "There are n minus k plus 1 windows; only record once the first window is full."
        ]
      }
    ],
    "edge_cases": [
      {
        "id": "e1",
        "description": "no readings"
      },
      {
        "id": "e2",
        "description": "a single reading"
      },
      {
        "id": "e3",
        "description": "window of 1"
      },
      {
        "id": "e4",
        "description": "window covers everything"
      },
      {
        "id": "e5",
        "description": "readings that only rise or only fall"
      },
      {
        "id": "e6",
        "description": "repeated values"
      }
    ],
    "common_mistakes": [
      {
        "id": "m1",
        "description": "stores values in the deque instead of indexes",
        "symptom": "can't tell when a reading has left the window"
      },
      {
        "id": "m2",
        "description": "is off by one when removing the front index",
        "symptom": "drops a loud reading one window too early, or keeps it one window too long"
      },
      {
        "id": "m3",
        "description": "computes the max of every window directly",
        "symptom": "correct but O(n * k), too slow for large windows"
      }
    ],
    "wrap_up_questions": [
      "What are the time and space complexity?",
      "How would you find the minimum of each window instead, and could you do both at once?"
    ]
  },
  "time_limit_min": 40,
  "illustration": null,
  "origin_note": "Original. Pattern: deque of indexes with decreasing readings."
}
