  "rubric": {
    "approaches": [
      {
        "name": "monotonic stack of unresolved indexes",
        "time": "O(n)",
        "space": "O(n)",
        "acceptable": true
      },
      {
        "name": "check every later building",
        "time": "O(n^2)",
        "space": "O(1)",
        "acceptable": false
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Confirms that 'taller' means strictly taller and what to put when nothing taller follows.",
        "look_for": [
          "asks whether equal height counts",
          "asks what to return when none is taller"
        ],
        "hints": [
          "Before you start, is there anything about 'taller' you'd want to pin down?",
          "Does a building of the same height count as taller?",
          "Confirm strictly taller, and 0 when nothing taller comes later."
        ]
      },
      {
        "id": "s2",
        "title": "Keep the buildings still waiting",
        "required": true,
        "order": 2,
        "description": "Scans left to right, keeping a stack of indexes that haven't found a taller building yet.",
        "look_for": [
          "uses a stack",
          "stores indexes rather than heights"
        ],
        "hints": [
          "Look at what you need to remember about earlier buildings.",
          "Which earlier buildings could the current building be the answer for?",
          "Keep a stack of indexes still waiting for a taller building; their heights never increase from bottom to top."
        ]
      },
      {
        "id": "s3",
        "title": "Resolve buildings the current one beats",
        "required": true,
        "order": 3,
        "description": "Pops every waiting index whose height is lower than the current building and records the distance.",
        "look_for": [
          "pops in a while loop",
          "records i - j as the distance"
        ],
        "hints": [
          "Look at what happens to waiting buildings when a tall one arrives.",
          "How many waiting buildings can one tall building answer at once?",
          "While the top of the stack is shorter than the current building, pop it and record the distance."
        ]
      },
      {
        "id": "s4",
        "title": "Handle ties and leftovers",
        "required": true,
        "order": 4,
        "description": "Leaves equal heights on the stack and gives 0 to any building still waiting at the end.",
        "look_for": [
          "uses a strict comparison",
          "initializes the answers to 0"
        ],
        "hints": [
          "Try your code on a list of equal heights.",
          "What answer do buildings that are still waiting at the end get?",
          "Pop only on strictly taller, and start every answer at 0."
        ]
      }
    ],
    "edge_cases": [
