  "rubric": {
    "approaches": [
      {
        "name": "union-find with path compression",
        "time": "O(k * \u03b1(k))",
        "space": "O(k)",
        "acceptable": true
      },
      {
        "name": "flood fill to recount after every addition",
        "time": "O(k * rows * cols)",
        "space": "O(rows * cols)",
        "acceptable": false
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Confirms that only up, down, left and right connect, and asks what happens when a cell is raised twice.",
        "look_for": [
          "asks whether diagonals connect",
          "asks about repeated additions",
          "mentions the grid size"
        ],
        "hints": [
          "Before you start, is there anything about connections you'd want to confirm?",
          "Do two land cells that only touch at a corner form one island?",
          "Confirm 4-direction connections and that re-adding a cell changes nothing."
        ]
      },
      {
        "id": "s2",
        "title": "Don't recount from scratch",
        "required": true,
        "order": 2,
        "description": "Recognizes that a flood fill after every addition is too slow and looks for incremental merging.",
        "look_for": [
          "says recounting each time is too slow",
          "mentions merging groups"
        ],
        "hints": [
          "Look at how much work your code repeats after each addition.",
          "When one cell rises, how many islands can actually change?",
          "Update the count incrementally: a new cell adds one island, and each merge removes one."
        ]
      },
      {
        "id": "s3",
        "title": "Merge with union-find",
        "required": true,
        "order": 3,
        "description": "Uses a union-find structure to merge the new cell with neighboring land, lowering the count once per merge.",
        "look_for": [
          "implements find and union",
          "decrements the count only when roots differ"
        ],
        "hints": [
          "Check what happens when the new cell touches the same island twice.",
          "If two of the new cell's neighbors are already one island, should you subtract two?",
          "Union the new cell with each land neighbor and subtract one only when their roots differ."
        ]
      },
      {
        "id": "s4",
        "title": "Keep find fast",
        "required": true,
        "order": 4,
        "description": "Uses path compression or union by size so finds stay nearly constant time.",
        "look_for": [
          "uses path compression",
          "or union by rank or size"
        ],
        "hints": [
          "Look at how long a find can take after many merges.",
          "Could your parent links form a long chain?",
          "Add path compression so roots stay close to every cell."
        ]
      },
      {
        "id": "s5",
        "title": "Handle repeats and big grids",
        "required": true,
        "order": 5,
        "description": "Skips cells that are already land and stores only added cells, not the whole grid.",
        "look_for": [
          "checks whether the cell is already land",
          "uses a dict instead of a full grid array"
        ],
        "hints": [
          "Try your code when the same cell is added twice, and on a 10,000 by 10,000 grid.",
          "Does re-adding a cell create a new island in your code, and how much memory does your grid take?",
          "Skip cells that are already land, and only store the cells that were added."
        ]
      }
    ],
    "edge_cases": [
      {
        "id": "e1",
        "description": "no additions"
      },
      {
        "id": "e2",
        "description": "a 1x1 grid"
      },
