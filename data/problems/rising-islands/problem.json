        "description": "the same cell added again"
      },
      {
        "id": "e4",
        "description": "diagonal cells don't connect"
      },
      {
        "id": "e5",
        "description": "one cell joins several islands"
      },
      {
        "id": "e6",
        "description": "a huge grid"
      }
    ],
    "common_mistakes": [
      {
        "id": "m1",
        "description": "adds an island when a cell is raised a second time",
        "symptom": "count goes up for repeated cells, failing [[0, 0], [0, 0]]"
      },
      {
        "id": "m2",
        "description": "subtracts one for every land neighbor",
        "symptom": "undercounts when two neighbors already belong to the same island"
      },
      {
        "id": "m3",
        "description": "allocates the full grid",
        "symptom": "uses about 100 million cells of memory for a 10,000 by 10,000 grid"
      }
    ],
    "wrap_up_questions": [
      "What are the time and space complexity?",
      "How would you also support a cell sinking back into the sea?"
    ]
  },
