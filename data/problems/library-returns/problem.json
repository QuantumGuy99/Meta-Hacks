  "rubric": {
    "approaches": [
      {
        "name": "hash set of ids seen so far",
        "time": "O(n)",
        "space": "O(n)",
        "acceptable": true
      },
      {
        "name": "compare every pair",
        "time": "O(n^2)",
        "space": "O(1)",
        "acceptable": false
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Asks what 'first' means when several books repeat, and what to return when nothing repeats or the list is empty.",
        "look_for": [
          "asks whether first means first to repeat or first to appear",
          "mentions the empty list",
          "confirms -1 when nothing repeats"
        ],
        "hints": [
          "Before you start, is there anything about 'first' you'd want to pin down?",
          "If two different books both come back twice, which one counts as first?",
          "Settle what 'first to repeat' means and the no-repeat case before you code."
        ]
      },
      {
        "id": "s2",
        "title": "Remember what you've seen",
        "required": true,
        "order": 2,
        "description": "Keeps the ids seen so far in a structure with fast membership checks.",
        "look_for": [
          "uses a set",
          "says checking a list each time would be slow"
        ],
        "hints": [
          "Look at how you check whether a book came back before.",
          "How quickly can you tell whether you've already seen an id?",
          "A hash set answers 'have I seen this?' in constant time."
        ]
      },
      {
        "id": "s3",
        "title": "Stop at the first repeat",
        "required": true,
        "order": 3,
        "description": "Returns as soon as an id is seen for the second time, scanning the list once.",
        "look_for": [
          "returns inside the loop",
          "explains it scans left to right once"
        ],
        "hints": [
          "Look at when your code decides on the answer.",
          "Once you find a book that came back, do you need to look any further?",
          "Scan once from the left and stop the moment an id is already in the set."
        ]
      },
      {
        "id": "s4",
        "title": "Handle no repeats",
        "required": true,
        "order": 4,
        "description": "Returns -1 when the loop finishes without a repeat, including for an empty list.",
        "look_for": [
          "returns -1 after the loop",
          "tests the empty list"
        ],
        "hints": [
          "Try your code on a list where every id is different.",
          "What does your function give back if the loop ends without finding anything?",
          "If the loop finishes without a repeat, the answer is -1; that also covers the empty list."
        ]
      }
    ],
    "edge_cases": [
      {
        "id": "e1",
        "description": "empty list"
      },
      {
        "id": "e2",
        "description": "a single return"
      },
      {
        "id": "e3",
        "description": "the book seen first is not the first to repeat"
      },
      {
        "id": "e4",
        "description": "a book returned three times"
      },
      {
        "id": "e5",
        "description": "the repeat is the very last return"
      }
    ],
    "common_mistakes": [
      {
        "id": "m1",
        "description": "finds all duplicates first, then returns the one that appeared earliest",
        "symptom": "returns 2 instead of 1 for [2, 1, 1, 2]"
      },
      {
        "id": "m2",
        "description": "returns None or 0 when nothing repeats",
        "symptom": "fails every test that expects -1"
      },
      {
        "id": "m3",
        "description": "keeps seen ids in a list",
        "symptom": "correct but too slow on large inputs"
      }
    ],
    "wrap_up_questions": [
      "What are the time and space complexity?",
      "How would you do this with O(1) extra space if the ids were small numbers, and what would you give up?"
    ]
  },
  "time_limit_min": 20,
  "illustration": null,
  "origin_note": "Original. Pattern: hash set of ids seen so far."
}
