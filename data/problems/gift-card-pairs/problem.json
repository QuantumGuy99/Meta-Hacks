  "rubric": {
    "approaches": [
      {
        "name": "hash map counting values seen so far",
        "time": "O(n)",
        "space": "O(n)",
        "acceptable": true
      },
      {
        "name": "sort and use two pointers, counting runs",
        "time": "O(n log n)",
        "space": "O(1)",
        "acceptable": true
      },
      {
        "name": "check every pair",
        "time": "O(n^2)",
        "space": "O(1)",
        "acceptable": false
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Confirms that a pair means two different cards, that equal values still count separately, and that values can be negative.",
        "look_for": [
          "asks whether one card can be used twice",
          "asks how duplicates count",
          "mentions negative values"
        ],
        "hints": [
          "Before you start, is there anything about what counts as a pair that you'd want to confirm?",
          "If three cards are worth 2 and the price is 4, how many pairs is that?",
          "Pin down that pairs use two different cards and that equal values form separate pairs."
        ]
      },
      {
        "id": "s2",
        "title": "Look up the complement",
        "required": true,
        "order": 2,
        "description": "For each card, looks for cards worth exactly price minus its value.",
        "look_for": [
          "mentions price minus the current value",
          "uses a dict or Counter"
        ],
        "hints": [
          "Think about what the other card in a pair must be worth.",
          "If you know one card's value and the price, what value are you looking for?",
          "For each card, you need a card worth the price minus its value; look that up in a hash map."
        ]
      },
      {
        "id": "s3",
        "title": "Count, don't just check",
        "required": true,
        "order": 3,
        "description": "Adds how many earlier cards have the complement, so repeated values are counted correctly.",
        "look_for": [
          "adds the stored count, not one",
          "tests repeated values"
        ],
        "hints": [
          "Try your code on several cards with the same value.",
          "If the complement appeared three times earlier, how many new pairs does this card make?",
          "Store counts of values seen so far and add the complement's count."
        ]
      },
      {
        "id": "s4",
        "title": "Don't pair a card with itself",
        "required": true,
        "order": 4,
        "description": "Looks only at earlier cards, updating the counts after the lookup.",
        "look_for": [
          "updates the map after the lookup",
          "tests [4] with price 8"
        ],
        "hints": [
          "Check the order in which you look up and record each card.",
          "Could a card worth exactly half the price end up paired with itself?",
          "Look up the complement first, then record the current card."
        ]
      }
    ],
    "edge_cases": [
      {
        "id": "e1",
        "description": "no cards"
      },
      {
        "id": "e2",
        "description": "a single card"
      },
      {
        "id": "e3",
        "description": "a card can't pair with itself"
      },
      {
        "id": "e4",
        "description": "many equal values"
      },
      {
        "id": "e5",
        "description": "negative values"
      }
    ],
    "common_mistakes": [
      {
        "id": "m1",
        "description": "records the card before looking up its complement",
        "symptom": "pairs a card with itself, counting 1 for [4] with price 8"
      },
      {
        "id": "m2",
        "description": "uses a set instead of counts",
        "symptom": "undercounts repeated values, giving 1 instead of 3 for [2, 2, 2] with price 4"
      },
      {
        "id": "m3",
        "description": "checks every pair with nested loops",
        "symptom": "correct but O(n^2), too slow for 100,000 cards"
      }
    ],
    "wrap_up_questions": [
      "What are the time and space complexity?",
      "How would you list the pairs themselves, and what's the worst-case size of that output?"
    ]
  },
  "time_limit_min": 30,
  "illustration": null,
  "origin_note": "Original. Pattern: hash map counting values seen so far."
