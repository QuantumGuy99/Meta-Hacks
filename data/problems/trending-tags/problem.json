  "rubric": {
    "approaches": [
      {
        "name": "count with a hash map, then sort by count and name",
        "time": "O(n + u log u)",
        "space": "O(u)",
        "acceptable": true
      },
      {
        "name": "count, then a heap of size k",
        "time": "O(n + u log k)",
        "space": "O(u)",
        "acceptable": true
      }
    ],
    "steps": [
      {
        "id": "s1",
        "title": "Clarify the input",
        "required": true,
        "order": 1,
        "description": "Asks how ties are broken, whether case matters, and what to do when k is larger than the number of different tags.",
        "look_for": [
          "asks about ties",
          "asks about case",
          "asks about k larger than the distinct tags"
        ],
        "hints": [
          "Before you start, is there anything about ranking you'd want to confirm?",
          "If two tags have the same count, which comes first?",
          "Settle ties, case sensitivity and a large k before you write the ranking."
        ]
      },
      {
        "id": "s2",
        "title": "Count each tag",
        "required": true,
        "order": 2,
        "description": "Builds a count per tag in one pass.",
        "look_for": [
          "uses a dict or Counter"
        ],
        "hints": [
          "Look at how you find how often each tag appears.",
          "Do you need to scan the whole list once per tag?",
          "Count every tag in a single pass with a hash map."
        ]
      },
      {
        "id": "s3",
        "title": "Rank by count, then name",
        "required": true,
        "order": 3,
        "description": "Sorts or selects by highest count first and alphabetical order for ties.",
        "look_for": [
          "sort key with negative count and the tag",
          "or a heap with the same ordering"
        ],
        "hints": [
          "Check the order your code puts two tied tags in.",
          "How can one sort handle both 'most frequent first' and 'alphabetical for ties'?",
          "Sort by count descending, then by tag name ascending, using a two-part key."
        ]
      },
      {
        "id": "s4",
        "title": "Cut to k safely",
        "required": true,
        "order": 4,
        "description": "Takes the first k results without failing when there are fewer than k tags.",
        "look_for": [
          "slices to k",
          "tests k larger than the distinct count"
        ],
        "hints": [
          "Try your code with k bigger than the number of different tags.",
          "What happens when you ask for 10 tags but only 2 exist?",
          "Slicing to k handles a short list naturally."
        ]
      }
    ],
    "edge_cases": [
      {
        "id": "e1",
        "description": "no tags"
      },
      {
        "id": "e2",
        "description": "a single tag"
      },
      {
        "id": "e3",
        "description": "ties broken alphabetically"
      },
      {
        "id": "e4",
        "description": "k larger than the number of different tags"
      },
      {
        "id": "e5",
        "description": "tags differ only by case"
      }
    ],
    "common_mistakes": [
      {
        "id": "m1",
        "description": "breaks ties by whichever tag appeared first",
        "symptom": "returns ['#z', '#a'] instead of ['#a', '#z']"
      },
      {
        "id": "m2",
        "description": "sorts by count only, using a reverse sort for everything",
        "symptom": "puts tied tags in reverse alphabetical order"
      },
      {
        "id": "m3",
        "description": "indexes up to k directly",
        "symptom": "crashes when k is more than the number of different tags"
      }
    ],
    "wrap_up_questions": [
      "What are the time and space complexity?",
      "How would you keep the top k up to date if tags kept streaming in?"
    ]
  },
  "time_limit_min": 30,
  "illustration": null,
  "origin_note": "Original. Pattern: count with a hash map, then sort by count and name."
}
