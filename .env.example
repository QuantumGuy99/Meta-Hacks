# Copy to .env (repo root) and fill in. .env is gitignored; never commit keys or paste them in chat.
# Read only by backend/crucible/config.py. See PLAN §19.2.

# --- Meta Model API (https://dev.meta.ai) ---
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MODEL_ANALYZER=muse-spark-1.3
MODEL_INTERVIEWER=muse-spark-1.3
MODEL_GRILL=muse-spark-1.3
MODEL_AUDIT=muse-wonder-1.0
MODEL_REPORT=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0
MODEL_SAM=sam-3.1
ASR_URL=wss://api.meta.ai/v1/asr/realtime
ASR_MODEL=muse-voice-transcribe-1.0
USE_CONTRIBUTOR_MODELS=0          # dev only, synthetic data only (content may be used for training)

# --- Partners ---
GLIMMER_BASE_URL=                 # Muse Glimmer host (Modal / Fireworks / OpenRouter); empty = attacker uses Spark
GLIMMER_API_KEY=
GLIMMER_MODEL=
BASETEN_BASE_URL=                 # Spark Open fallback
BASETEN_API_KEY=
SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
MODAL_TOKEN_ID=                   # or run `modal token new` (writes ~/.modal.toml)
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=crucible-runner

# --- App ---
RUNNER=modal                      # modal | local
ALLOW_LOCAL_RUNNER=0              # LocalRunner refuses to start unless RUNNER=local and this is 1
DATABASE_URL=sqlite:///./var/crucible.db   # relative to backend/; sqlite:///:memory: for no file
MOCK=0                            # 1 = replay recorded sessions (frontend dev only; never in the demo)
CORS_ORIGINS=http://localhost:3000
MAX_SESSIONS_PER_IP_PER_DAY=10

# --- Frontend (read by Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_FIXTURES=0            # dev only: frontend FixtureTransport until MOCK mode works
